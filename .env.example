# Copy this file to .env.local (local dev) or .env.production (prod).
# Never commit either — both are gitignored.
# See docs/environments.md for the full switching convention.

# --- Environment ---
# Set to "local" or "production"
APP_ENV=local

# --- Database ---
# Local dev: points at Docker Postgres (docker compose up)
# Production: points at Supabase (provisioned in Epic 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backyard_data

# Supabase — provisioned in Epic 3 (Database Design)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# --- Data ingestion ---
# Socrata API token — register at data.seattle.gov to avoid rate limits
SOCRATA_APP_TOKEN=your_app_token_here

# --- Orchestration ---
# Dagster Cloud — provisioned when Dagster Cloud workspace is set up
DAGSTER_CLOUD_API_TOKEN=your_dagster_cloud_token_here

# --- Map UI ---
# Mapbox — provisioned when map UI is built (Epic 5)
MAPBOX_TOKEN=pk.your_mapbox_token_here
